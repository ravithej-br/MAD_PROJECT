rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── USER PROFILES ───
    // Anyone authenticated can read profiles (for runner stats, names, etc.)
    // Only the profile owner can write their own document
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
    }

    // ─── TASKS ───
    // All authenticated users can read tasks
    // Only the poster who owns the task can create (posterId must match auth uid)
    // Updates are allowed for the poster (owner) or the assigned runner
    match /tasks/{taskId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.posterId == request.auth.uid;

      allow update: if request.auth != null
                    && (
                      // Poster can update their own tasks (approve, cancel, rate)
                      resource.data.posterId == request.auth.uid
                      // Runner can update tasks assigned to them (complete, location)
                      || resource.data.runnerId == request.auth.uid
                      // Any runner can accept an open task (sets runnerId to themselves)
                      || (resource.data.status == 'open'
                          && request.resource.data.runnerId == request.auth.uid)
                    );

      // Only the poster can delete their own tasks
      allow delete: if request.auth != null
                    && resource.data.posterId == request.auth.uid;
    }
  }
}
