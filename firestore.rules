rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: Is user logged in?
    function isLoggedIn() {
      return request.auth != null;
    }
    
    // Helper: Is the data being written by the owner?
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      // Everyone can read profiles, only owner can edit
      allow read: if isLoggedIn();
      allow write: if isOwner(userId);
    }

    match /tasks/{taskId} {
      allow read: if isLoggedIn();
      
      // Validation on creation
      allow create: if isLoggedIn() && 
        request.resource.data.posterId == request.auth.uid &&
        request.resource.data.title is string && request.resource.data.title.size() >= 5 &&
        request.resource.data.price is number && request.resource.data.price > 0 &&
        request.resource.data.category is string;

      allow update: if isLoggedIn() && (
        // 1. Runner accepting an open task
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['runnerId', 'status']) &&
         resource.data.status == 'open' &&
         resource.data.posterId != request.auth.uid &&
         request.resource.data.runnerId == request.auth.uid &&
         request.resource.data.status == 'in-progress') ||
         
        // 2. Poster cancelling or approving
        (resource.data.posterId == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'approvedAt', 'hasRated', 'ratingValue', 'feedback'])) ||
         
        // 3. Runner completing or updating location
        (resource.data.runnerId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'completedAt', 'runnerLocation']))
      );
      
      // No one can delete tasks; use status = 'cancelled' for history
      allow delete: if false;
    }
  }
}
