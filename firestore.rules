rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isLoggedIn() {
      return request.auth != null;
    }
    
    // 🔥 Emergency Permissive Rules to bypass "Missing or Insufficient Permission"
    match /users/{userId} {
      allow read: if true;
      allow write: if isLoggedIn();
    }

    match /tasks/{taskId} {
      allow read: if isLoggedIn();
      allow write: if isLoggedIn();
      allow delete: if false;
    }
  }
}
